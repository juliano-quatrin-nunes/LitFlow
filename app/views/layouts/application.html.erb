<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%
      page_title       = content_for?(:title) ? "#{content_for(:title)} · Litflow" : "Litflow — Repertório Litúrgico"
      page_description = content_for?(:description) ? content_for(:description) : "Organize seu repertório litúrgico, monte roteiros de celebração e exporte slides para a projeção. Tudo em um só lugar."
      share_image_url  = "#{request.base_url}#{image_path('liflow-logo.png')}"
      page_url         = request.original_url
    %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#0b0b0c">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Litflow">
    <meta name="mobile-web-app-capable" content="yes">

    <%# Open Graph (Facebook, WhatsApp, LinkedIn, Slack, etc.) %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Litflow">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= page_url %>">
    <meta property="og:image" content="<%= share_image_url %>">
    <meta property="og:image:alt" content="Litflow — Repertório Litúrgico">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= share_image_url %>">
    <meta name="twitter:image:alt" content="Litflow — Repertório Litúrgico">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= image_path('favicon.png') %>" type="image/png">
    <link rel="shortcut icon" href="<%= image_path('favicon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= image_path('favicon.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground antialiased min-h-screen">
    <div class="flex">
      <%= render "layouts/sidebar" %>

      <div class="flex-1 flex flex-col min-h-screen h-screen overflow-hidden">
        <%# Mobile Header %>
        <header class="md:hidden flex items-center justify-between p-4 border-b bg-card">
          <%= link_to root_path, class: "inline-block" do %>
            <%= image_tag "liflow-logo.png", alt: "Litflow", class: "h-10 w-auto" %>
          <% end %>
          <button class="p-2 -mr-2" data-action="sidebar#toggle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
        </header>

        <main class="flex-1 overflow-y-auto overflow-x-hidden">
          <div class="container mx-auto py-6 px-6 md:px-12 max-w-7xl">
            <%= ui.flash %>
            <%= yield %>
          </div>
        </main>

        <%= yield :bottom_bar %>
      </div>
    </div>

    <%= turbo_frame_tag :modal, target: :_top %>
    <div id="toasts"
         class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"
         aria-live="polite"></div>
  </body>
</html>
