<%= ui.sidebar class: "hidden md:flex flex-col w-64 border-r h-screen sticky top-0 bg-sidebar overflow-y-auto", data: { controller: "sidebar", sidebar_target: "menu" } do %>
  <div class="px-6 pt-6 pb-2">
    <%= link_to root_path, class: "flex items-center gap-2.5 font-bold text-xl tracking-tight" do %>
      <span class="bg-primary text-primary-foreground p-1.5 rounded-lg shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </span>
      <span class="text-secondary tracking-tight">Litflow</span>
    <% end %>
  </div>

  <div class="border-b border-border mx-6 mb-3"></div>

  <%= ui.sidebar_section class: "px-4 py-1" do %>
    <%= ui.sidebar_title "Biblioteca", class: "text-[10px] uppercase tracking-[0.2em] px-2 mb-1" %>
    <%= ui.sidebar_menu do %>
      <%= ui.sidebar_link url: repertoire_musics_path do %>
        <div class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music-2 opacity-70"><circle cx="8" cy="18" r="4"/><path d="M12 18V2l7 2"/></svg>
          Músicas
        </div>
      <% end %>
      <%= ui.sidebar_link url: repertoire_authors_path do %>
        <div class="flex items-center gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users opacity-70"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="19" cy="4" r="3"/></svg>
          Autores
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= ui.sidebar_section class: "px-4 py-1" do %>
    <%= ui.sidebar_title "Meu Espaço", class: "text-[10px] uppercase tracking-[0.2em] px-2 mb-1" %>
    <%= ui.sidebar_menu do %>
      <%= ui.sidebar_link url: authenticated? ? saved_musics_path : new_session_path do %>
        <div class="flex items-center justify-between w-full">
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-library opacity-70"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
            Meu Repertório
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= ui.sidebar_section class: "px-4 py-1 mt-auto mb-4" do %>
    <%= ui.sidebar_title "Gestão", class: "text-[10px] uppercase tracking-[0.2em] px-2 mb-1" %>
    <%= ui.sidebar_menu do %>
      <% if authenticated? && Current.user.admin? %>
        <%= ui.sidebar_link url: admin_invitations_path do %>
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-plus opacity-70"><path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="M19 16v6"/><path d="M16 19h6"/></svg>
            Convites
          </div>
        <% end %>
      <% end %>
      <%= ui.sidebar_link disabled: true do %>
        <div class="flex items-center justify-between w-full">
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-church opacity-70"><path d="m18 7 4 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9l4-2"/><path d="M14 22v-4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v4"/><path d="M18 5 12 2 6 5"/><path d="M12 7V2"/></svg>
            Paróquia
          </div>
          <%= ui.badge "Em breve", size: :xs, variant: :default, class: "opacity-60 font-normal" %>
        </div>
      <% end %>
      <%= ui.sidebar_link disabled: true do %>
        <div class="flex items-center justify-between w-full">
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user opacity-70"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Usuário
          </div>
          <%= ui.badge "Em breve", size: :xs, variant: :default, class: "opacity-60 font-normal" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <div class="border-t border-border mx-6 my-2"></div>

  <%= ui.sidebar_section class: "px-4 py-1 mb-6" do %>
    <%= ui.sidebar_menu do %>
      <% if authenticated? %>
        <div class="px-2 py-2 mb-2 text-xs font-medium text-muted-foreground border-b border-border/50 truncate">
          <%= Current.user.email_address %>
        </div>
        <%= ui.sidebar_link url: session_path, data: { turbo_method: :delete } do %>
          <div class="flex items-center gap-2.5 text-destructive hover:text-destructive">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out opacity-70"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            Sair
          </div>
        <% end %>
      <% else %>
        <%= ui.sidebar_link url: new_session_path do %>
          <div class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-in opacity-70"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
            Entrar
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
