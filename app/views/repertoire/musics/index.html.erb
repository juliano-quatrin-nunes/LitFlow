<div class="w-full">
  <%= ui.header class: "mb-8" do %>
    <div class="flex flex-col gap-1">
      <%= ui.breadcrumbs do %>
        <%= ui.breadcrumb "Biblioteca", url: repertoire_musics_path %>
        <%= ui.breadcrumb "Músicas" %>
      <% end %>
      <h1 class="font-bold text-3xl tracking-tight text-foreground mt-2">Repertório Musical</h1>
    </div>

    <%= ui.btn url: new_repertoire_music_path, class: "gap-2" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      Nova Música
    <% end %>
  <% end %>

  <%= render partial: "repertoire/musics/library", locals: {
    musics: @musics,
    seasons: @seasons,
    parts: @parts,
    user_saved_musics: @user_saved_musics,
    library_scope: @library_scope,
    library_path: ->(p = {}) { repertoire_musics_path(p) },
    frame_id: "musics",
    mode: :browse
  } %>
</div>
