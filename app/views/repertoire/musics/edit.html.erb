<div class="mx-auto md:w-2/3 w-full">
  <div class="mb-8">
    <h1 class="font-bold text-4xl">Editando Música</h1>
  </div>

  <%= ui.card class: "p-8" do %>
    <%= render "form", music: @music %>
  <% end %>

  <div class="mt-8 flex justify-between items-center">
    <%= ui.btn "Voltar ao repertório", url: repertoire_musics_path, variant: :ghost %>
    <%= ui.btn "Ver esta música", url: repertoire_music_by_author_show_path(@music.author, @music), variant: :secondary %>
  </div>
</div>
