<div class="mx-auto md:w-2/3 w-full">
  <div class="mb-8">
    <h1 class="font-bold text-4xl">Editing Music</h1>
  </div>

  <%= ui.card class: "p-8" do %>
    <%= render "form", music: @music %>
  <% end %>

  <div class="mt-8 flex justify-between items-center">
    <%= ui.btn "Back to repertoire", url: repertoire_musics_path, variant: :ghost %>
    <%= ui.btn "Show this music", url: repertoire_music_path(@music), variant: :secondary %>
  </div>
</div>
