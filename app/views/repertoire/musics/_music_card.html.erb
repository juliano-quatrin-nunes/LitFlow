<%= link_to repertoire_music_by_author_show_path(music.author, music, key: local_assigns[:preferred_key]), class: "block group h-full", data: { turbo_frame: "_top" } do %>
  <%= ui.card class: "hover:border-primary/50 transition-all shadow-sm group-hover:shadow-md h-full flex flex-col" do %>
    <div class="px-4 py-3 flex flex-col gap-2 flex-grow">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <h2 class="text-xl font-bold text-foreground leading-tight group-hover:text-primary transition-colors"><%= music.title %></h2>
            <% if local_assigns[:preferred_key].present? && local_assigns.fetch(:show_badge, true) %>
              <%= ui.badge preferred_key, variant: :outline, class: "bg-primary/5 text-primary border-primary/20 shrink-0" %>
            <% end %>
          </div>
          <p class="text-sm text-muted-foreground flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user opacity-50"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <%= music.author_name %>
          </p>
        </div>

        <% if music.mass_parts.any? || music.liturgical_seasons.any? %>
          <div class="flex flex-wrap items-center gap-2 shrink-0 md:justify-end max-w-[350px]">
            <% music.mass_parts.each do |part| %>
              <%= ui.badge part.name, variant: :secondary, size: :xs %>
            <% end %>
            <% music.liturgical_seasons.each do |season| %>
              <%= ui.badge season.name, variant: :outline, size: :xs %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% 
        # Extract the first few lines of lyrics for the preview
        lines = []
        music.content_json.each do |section|
          next if section["type"] == "label" || section["type"] == "intro"
          section["lines"].each do |line|
            lyric = line["parts"].map { |p| p["lyric"] }.join.strip
            lines << lyric if lyric.present?
            break if lines.size >= 2
          end
          break if lines.size >= 2
        end
        preview = lines.join(" / ")
      %>
      <% if preview.present? %>
        <p class="text-sm text-muted-foreground line-clamp-1 italic opacity-70 font-serif mt-1">
          "<%= preview.truncate(150) %>"
        </p>
      <% end %>

      <% if local_assigns[:remarks].present? %>
        <div class="mt-auto pt-3 border-t border-border/50">
          <p class="text-xs text-muted-foreground line-clamp-2 italic">
            "<%= remarks %>"
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
