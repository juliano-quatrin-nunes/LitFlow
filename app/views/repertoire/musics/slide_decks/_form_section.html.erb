<%# locals: (music:, form:) %>
<%# Slide editor block rendered INSIDE the music form. %>
<%# Regenerate is a non-submit button that POSTs via fetch (avoids nested-form HTML). %>
<% deck = music.slide_deck %>
<% has_slides = deck && deck.slides_json.present? %>
<% cifra_changed = deck && deck.slides_generated_from.present? && music.content_raw.present? &&
                   Digest::SHA1.hexdigest(music.content_raw) != deck.slides_generated_from %>

<div class="mt-6 flex flex-col gap-3">
  <% if cifra_changed %>
    <div data-role="cifra-changed-banner"
         class="flex items-start gap-2 bg-yellow-50 border border-yellow-300 text-yellow-900 text-sm rounded-md px-3 py-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/></svg>
      <span>A cifra mudou desde a última geração dos slides. Clique em <strong>Regenerar slides</strong> para atualizar.</span>
    </div>
  <% end %>

  <turbo-frame id="slide_deck_editor">
    <% if has_slides %>
      <div class="rounded-lg border border-border bg-card">
        <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-border">
          <div>
            <div class="text-sm font-semibold">Slides</div>
            <div class="text-xs text-muted-foreground"><%= deck.slides_json.size %> seções · edite o conteúdo nas abas abaixo</div>
          </div>
          <button type="button"
                  data-controller="regenerate-slides"
                  data-regenerate-slides-url-value="<%= repertoire_music_regenerate_slide_deck_path(music.author, music) %>"
                  data-action="click->regenerate-slides#trigger"
                  class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-md border border-border hover:bg-muted text-foreground transition-colors shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
            Regenerar slides
          </button>
        </div>

        <div class="p-4">
          <%= form.hidden_field "slide_deck_attributes[id]", value: deck.id %>

          <%= render "repertoire/musics/slide_decks/section_editor",
                slide_deck: deck,
                sections: deck.slides_json,
                form: form %>

          <%= render "repertoire/musics/slide_decks/sequence_editor",
                slide_deck: deck,
                sections: deck.slides_json,
                sequence: deck.slide_sequence,
                form: form %>
        </div>
      </div>
    <% end %>
  </turbo-frame>
</div>
