<%= form_with(model: music, url: music.persisted? ? repertoire_music_by_author_update_path(music.author, music) : repertoire_musics_path, class: "form") do |form| %>
  <% if music.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(music.errors.count, "error") %> proibiram esta música de ser salva:</h2>

      <ul>
        <% music.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.text_field :title, 
        label: "Título", 
        placeholder: "Título da música",
        required: true %>

  <%= form.choices :author_id, 
        (music.author ? [[music.author.name, music.author.id]] : []), 
        { label: "Autor", include_blank: "Selecione ou crie um autor..." }, 
        { 
          data: { 
            search: repertoire_authors_path(format: :json),
            new: repertoire_authors_path
          } 
        } 
  %>

  <%= form.text_field :original_key, 
        label: "Tom Original", 
        placeholder: "ex: E, G, Am" %>

  <%= form.text_field :youtube_url, 
        label: "Link do YouTube", 
        placeholder: "https://www.youtube.com/watch?v=..." %>

  <%= form.text_area :content_raw,
        label: "Cole a Música (Cifras sobre a Letra)",
        rows: 15,
        placeholder: "E                  C#m\nVem e eu mostrarei que o meu caminho",
        class: "font-mono" %>

  <% if music.persisted? %>
    <%= render "repertoire/musics/slide_decks/form_section",
          music: music,
          form: form %>
  <% else %>
    <div data-role="slide-section-placeholder"
         class="mt-6 rounded-lg border border-dashed border-border bg-muted/30 px-4 py-5 flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mt-0.5 shrink-0"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/><path d="M12 16v5"/></svg>
      <div class="flex flex-col gap-1 text-sm">
        <strong class="text-foreground">Slides</strong>
        <span class="text-muted-foreground">
          Os slides serão gerados automaticamente a partir da cifra ao salvar.
          Você poderá revisar tipos, rótulos e linhas em seguida.
        </span>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <%= ui.btn form.object.persisted? ? "Atualizar Música" : "Criar Música", type: :submit, variant: :primary, block: true %>
  </div>
<% end %>
