<div class="mx-auto md:w-2/3 w-full">
  <% if @user.errors.any? %>
    <div class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <h1 class="font-bold text-4xl">Criar sua conta</h1>
  <p class="text-muted-foreground mt-2">Você foi convidado para participar do Litflow com o e-mail: <strong><%= @invitation.email %></strong></p>

  <%= form_with model: @user, url: registration_path(token: @invitation.token), class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Mínimo 8 caracteres", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, "Confirme sua senha" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repita a senha", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= form.submit "Criar Conta", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>