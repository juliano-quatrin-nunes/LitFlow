<div class="mx-auto max-w-sm w-full py-12">
  <div class="text-center mb-10">
    <%= link_to root_path, class: "inline-flex items-center gap-2.5 font-bold text-3xl tracking-tight" do %>
      <span class="bg-primary text-primary-foreground p-2 rounded-xl shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </span>
      <span class="text-secondary tracking-tight">Litflow</span>
    <% end %>
    <p class="text-muted-foreground mt-3">Acesse seu repertório e setlists</p>
  </div>

  <%= ui.card class: "p-8 shadow-sm border-border/50" do %>
    <% if alert = flash[:alert] %>
      <div class="py-2.5 px-4 bg-destructive/10 border border-destructive/20 mb-6 text-destructive text-sm font-medium rounded-lg text-center">
        <%= alert %>
      </div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="py-2.5 px-4 bg-success/10 border border-success/20 mb-6 text-success-foreground text-sm font-medium rounded-lg text-center">
        <%= notice %>
      </div>
    <% end %>

    <%= form_with url: session_url, class: "space-y-6" do |form| %>
      <%= form.email_field :email_address, 
          label: "E-mail",
          required: true, 
          autofocus: true, 
          autocomplete: "username", 
          placeholder: "seu@email.com", 
          value: params[:email_address], 
          class: "block w-full rounded-md border-border bg-background px-3 py-2 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" %>

      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <%= form.label :password, "Senha", class: "block text-sm font-medium text-foreground" %>
          <%= link_to "Esqueceu a senha?", new_password_path, class: "text-xs text-primary hover:underline font-medium" %>
        </div>
        <%= form.password_field :password, 
            label: false,
            required: true, 
            autocomplete: "current-password", 
            placeholder: "••••••••", 
            maxlength: 72, 
            class: "block w-full rounded-md border-border bg-background px-3 py-2 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" %>
      </div>

      <div class="pt-2">
        <%= form.submit "Entrar", class: "w-full cursor-pointer rounded-md px-4 py-2.5 bg-primary hover:opacity-90 text-primary-foreground font-bold transition-all shadow-md active:scale-[0.98]" %>
      </div>
    <% end %>
  <% end %>

  <p class="mt-8 text-center text-sm text-muted-foreground">
    Não tem uma conta? <span class="font-medium text-foreground">Peça um convite ao administrador.</span>
  </p>
</div>
