<%= ui.header class: "mb-8" do %>
  <div class="flex flex-col gap-1">
    <%= ui.breadcrumbs do %>
      <%= ui.breadcrumb "Meu Espaço" %>
      <%= ui.breadcrumb "Meus Roteiros", url: setlists_path %>
      <%= ui.breadcrumb @setlist.name %>
    <% end %>
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-2">
      <div>
        <h1 class="font-bold text-3xl tracking-tight text-foreground flex items-center gap-3">
          <%= @setlist.name %>
          <%= ui.badge @setlist.setlist_type.capitalize, variant: :secondary %>
        </h1>
        <div class="flex items-center gap-4 text-muted-foreground mt-2 text-sm">
          <% if @setlist.date.present? %>
            <div class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              <%= l @setlist.date, format: :long %>
            </div>
          <% end %>
          <% if @setlist.location.present? %>
            <div class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= @setlist.location %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="flex flex-wrap items-center gap-3">
        <textarea id="public-setlist-url" class="hidden"><%= public_setlist_url(uid: @setlist.uid) %></textarea>
        <%= ui.btn variant: :outline, size: :sm,
                   data: {
                     controller: "clipboard",
                     action: "clipboard#copy",
                     clipboard_source_id_value: "public-setlist-url",
                     clipboard_success_text_value: "Link copiado!"
                   } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link mr-1"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          Compartilhar
        <% end %>

        <%= ui.dropdown do %>
          <%= ui.dropdown_trigger do %>
            <%= ui.btn variant: :outline, size: :sm do %>
              Ações
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down ml-1 opacity-50"><path d="m6 9 6 6 6-6"/></svg>
            <% end %>
          <% end %>

          <%= ui.dropdown_menu class: "w-56" do %>
            <%= ui.dropdown_link "Editar Roteiro", url: edit_setlist_path(@setlist), data: { turbo_frame: :_top } %>
            <%= ui.dropdown_link "Ver Link Público", url: public_setlist_path(uid: @setlist.uid), data: { turbo_frame: :_top } %>
            <%= ui.dropdown_divider %>
            <%= ui.dropdown_button "Excluir Roteiro",
                                url: setlist_path(@setlist),
                                class: "text-destructive hover:bg-destructive/10",
                                method: :delete,
                                data: { turbo_confirm: "Tem certeza que deseja excluir este roteiro?" } %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if @setlist.missa? %>
  <div class="flex flex-col gap-6 mt-8">
    <% @setlist.missa_slots.each do |part, items| %>
      <section class="flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-border pb-1">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground"><%= part.name %></h2>
          <div class="flex items-center gap-3">
            <span class="text-xs text-muted-foreground"><%= items.size %> música<%= "s" if items.size != 1 %></span>
            <%= link_to new_setlist_item_path(setlist_id: @setlist.id, mass_part_id: part.id, part: part.slug),
                        data: { turbo_frame: "modal" },
                        class: "text-xs font-medium text-secondary hover:text-secondary-hover" do %>
              + Adicionar
            <% end %>
          </div>
        </div>

        <% if items.any? %>
          <div data-controller="sortable"
               data-sortable-url-value="<%= reorder_setlist_items_path %>"
               class="flex flex-col gap-3">
            <% items.each do |item| %>
              <%= render partial: "setlists/item", locals: { item: item } %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-muted-foreground italic py-2">Sem músicas neste slot.</p>
        <% end %>
      </section>
    <% end %>

    <% unassigned = @setlist.items.includes(:music).where(mass_part_id: nil).order(:position) %>
    <% if unassigned.any? %>
      <section class="flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-border pb-1">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">Sem Categoria</h2>
          <span class="text-xs text-muted-foreground"><%= unassigned.size %> música<%= "s" if unassigned.size != 1 %></span>
        </div>
        <div data-controller="sortable"
             data-sortable-url-value="<%= reorder_setlist_items_path %>"
             class="flex flex-col gap-3">
          <% unassigned.each do |item| %>
            <%= render partial: "setlists/item", locals: { item: item } %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="mt-8">
    <div class="flex justify-end mb-4">
      <%= link_to new_setlist_item_path(setlist_id: @setlist.id),
                  data: { turbo_frame: "modal" },
                  class: "text-sm font-medium text-secondary hover:text-secondary-hover inline-flex items-center gap-1" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Adicionar Música
      <% end %>
    </div>

    <% if @setlist.items.any? %>
      <div data-controller="sortable"
           data-sortable-url-value="<%= reorder_setlist_items_path %>"
           class="flex flex-col gap-3">
        <% @setlist.items.includes(:music).order(:position).each do |item| %>
          <%= render partial: "setlists/item", locals: { item: item } %>
        <% end %>
      </div>
    <% else %>
      <%= ui.card class: "p-8 text-center" do %>
        <p class="text-muted-foreground">Músicas serão adicionadas aqui em breve.</p>
      <% end %>
    <% end %>
  </div>
<% end %>
