<%= ui.header class: "mb-8" do %>
  <div class="flex flex-col gap-1">
    <%= ui.breadcrumbs do %>
      <%= ui.breadcrumb "Meu Espaço" %>
      <%= ui.breadcrumb "Meus Roteiros", url: setlists_path %>
      <%= ui.breadcrumb @setlist.name, url: setlist_path(@setlist) %>
      <%= ui.breadcrumb "Editar" %>
    <% end %>
    <h1 class="font-bold text-3xl tracking-tight text-foreground">Editar Roteiro</h1>
  </div>
<% end %>

<div class="max-w-2xl">
  <%= ui.card class: "p-6" do %>
    <%= form_with model: @setlist, class: "form" do |form| %>
      <% if @setlist.errors.any? %>
        <div class="py-2.5 px-4 bg-destructive/10 border border-destructive/20 text-destructive text-sm font-medium rounded-lg mb-4">
          <%= @setlist.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form.text_field :name, label: "Nome do Evento", required: true, autofocus: true, placeholder: "Ex: Missa de Domingo" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <%= form.date_field :date, label: "Data" %>
          <%= form.select :setlist_type, Setlist.setlist_types.keys.map { |k| [k.capitalize, k] }, {}, { label: "Tipo" } %>
        </div>

        <%= form.text_field :location, label: "Local / Paróquia", placeholder: "Ex: Paróquia São Paulo" %>

        <div class="pt-4 flex items-center justify-end gap-3 border-t border-border mt-2">
          <%= link_to "Cancelar", setlist_path(@setlist), class: "text-sm font-medium text-muted-foreground hover:text-foreground transition-colors" %>
          <%= form.submit "Salvar Alterações", class: "cursor-pointer rounded-md px-4 py-2 bg-primary hover:opacity-90 text-primary-foreground font-bold transition-all shadow-sm active:scale-[0.98]" %>
        </div>
    <% end %>
  <% end %>
</div>
