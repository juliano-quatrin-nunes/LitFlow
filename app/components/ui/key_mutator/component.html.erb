<div class="inline-flex items-center bg-secondary/30 border border-border rounded-lg p-0.5" data-controller="key-mutator">
  <% lower_key = Repertoire::TranspositionService.transpose_key(@current_key, -1) %>
  <%= helpers.ui.btn url: helpers.repertoire_music_by_author_show_path(@music.author, @music, key: lower_key), 
            variant: :ghost, 
            size: :icon_xs, 
            class: "!w-7 !h-7 hover:bg-background/50 transition-colors",
            data: { 
              turbo_frame: @turbo_frame,
              turbo_action: "advance"
            } do %>
    <span class="icon icon-minus !h-3 !w-3"></span>
  <% end %>

  <%= helpers.ui.dropdown do %>
    <%= helpers.ui.dropdown_trigger as: :badge, 
                           variant: (is_original? ? :default : :info), 
                           size: :md, 
                           class: cn(
                             "cursor-pointer transition-all select-none min-w-[3.5rem] justify-center hover:opacity-80 relative mx-0.5",
                             "pr-5" => !is_original?
                           ) do %>
      <span class="flex-1 text-center font-bold"><%= @current_key %></span>

      <% unless is_original? %> <%# herb:disable actionview-no-silent-helper %>
        <%= link_to helpers.repertoire_music_by_author_show_path(@music.author, @music, key: @music.original_key), 
                  data: { 
                    turbo_frame: @turbo_frame,
                    turbo_action: "advance",
                  }, 
                  title: "Voltar ao tom original", 
                  class: "absolute right-0.5 text-info-soft-foreground/70 hover:text-info-soft-foreground hover:bg-info/10 rounded-full p-0.5 transition-colors" do %>
          <span class="icon icon-x-mark !h-3 !w-3"></span>
        <% end %>
      <% end %>
    <% end %>

    <%= helpers.ui.dropdown_menu class: "grid grid-cols-4 gap-1 p-2 w-48 !py-2 !px-2" do %>
      <% Repertoire::TranspositionService::CHROMATIC_KEYS.each do |key| %> <%# herb:disable actionview-no-silent-helper %>
        <% 
          display_key = @music.original_key.end_with?("m") ? "#{key}m" : key
          is_active = (@current_key == display_key)
          is_orig = (@music.original_key == display_key)
        %>
        <li class="list-none contents">
          <%= link_to display_key, helpers.repertoire_music_by_author_show_path(@music.author, @music, key: display_key), 
                      data: { 
                        turbo_frame: @turbo_frame,
                        turbo_action: "advance"
                      },
                      class: cn(
                        "flex items-center justify-center h-10 rounded-md text-xs font-semibold transition-all hover:bg-secondary",
                        "bg-blue-600 text-white shadow-sm hover:bg-blue-700" => is_active,
                        "border-2 border-blue-600/30" => is_orig && !is_active
                      ) %>
        </li>
      <% end %>
    <% end %>
  <% end %>

  <% higher_key = Repertoire::TranspositionService.transpose_key(@current_key, 1) %>
  <%= helpers.ui.btn url: helpers.repertoire_music_by_author_show_path(@music.author, @music, key: higher_key), 
            variant: :ghost, 
            size: :icon_xs, 
            class: "!w-7 !h-7 hover:bg-background/50 transition-colors",
            data: { 
              turbo_frame: @turbo_frame,
              turbo_action: "advance"
            } do %>
    <span class="icon icon-plus !h-3 !w-3"></span>
  <% end %>
</div>
